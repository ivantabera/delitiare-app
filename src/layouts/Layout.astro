---
// src/layouts/Layout.astro
import "../styles.css";
import LegalModals from "../components/LegalModals.astro";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = "Delitiāre - Santuario de recuperación física y mental para el hombre de negocios en CDMX. Protocolos de descarga tensional.",
  image: propImage,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || "https://delitiare.mx");

// Asegura que la imagen sea absoluta para previsualizaciones en WhatsApp
const image = propImage 
  ? (propImage.startsWith('http') ? propImage : `https://delitiare.mx${propImage}`) 
  : "https://delitiare.mx/assets/hero1.jpg";

const pageTitle = title ? `${title} | Delitiāre` : "Delitiāre | Executive Wellness & Spa CDMX";

// SCHEMA.ORG (JSON-LD) - Alineado con el Protocolo de Privacidad
const schema = {
  "@context": "https://schema.org",
  "@type": "DaySpa",
  "@id": "https://delitiare.mx/",
  "name": "Delitiāre — Executive Wellness",
  "url": "https://delitiare.mx/",
  "image": "https://delitiare.mx/assets/hero1.jpg",
  "logo": "https://delitiare.mx/assets/delitiare-logo.png",
  "description": description,
  "telephone": "+52 33 4287 4709",
  "priceRange": "$2,800 - $4,800 MXN",
  "address": {
    "@type": "PostalAddress",
    "addressLocality": "Ciudad de México",
    "addressRegion": "CDMX",
    "addressCountry": "MX",
    "streetAddress": "Colonia Anzures (Suite Privada) & Cobertura In-House"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 19.4326, 
    "longitude": -99.1332
  },
  "areaServed": [
    { "@type": "Place", "name": "Anzures", "description": "Ubicación de nuestra Suite Privada exclusiva." },
    { "@type": "AdministrativeArea", "name": "Polanco" },
    { "@type": "AdministrativeArea", "name": "Santa Fe" },
    { "@type": "AdministrativeArea", "name": "Bosques de las Lomas" },
    { "@type": "AdministrativeArea", "name": "Lomas de Chapultepec" },
    { "@type": "AdministrativeArea", "name": "Paseo de la Reforma" },
    { "@type": "Place", "name": "Hoteles 5 Estrellas", "description": "Servicio In-House disponible en zonas premium." }
  ],
  "serviceType": "Executive Wellness & PDT (Protocolo de Descarga Tensional)",
  "audience": {
    "@type": "Audience",
    "audienceType": "Executives and Business Professionals"
  }
};
---

<!doctype html>
<html lang="es-MX">
  <head>
    <script async src="https://www.googletagmanager.com/gtag/js?id=AW-17739710700"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() { dataLayer.push(arguments); }
      gtag("js", new Date());
      gtag("config", "AW-17739710700");
    </script>

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0e0f12" />
    <meta http-equiv="x-dns-prefetch-control" content="on">
    <link rel="dns-prefetch" href="https://delitiare.mx">

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:image" content={image} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;600;700&family=Manrope:wght@300;400;600&display=swap" rel="stylesheet" />

    <link rel="icon" href="/assets/icons/favicon.ico" />
    <link rel="manifest" href="/assets/icons/manifest.json" />

    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <slot />
    <LegalModals />
    <script>
      import "../scripts/header.js";
      import "../scripts/wa-links.js";
      import "../scripts/forms-and-modals.js"; 
      import "../scripts/carousel.js";
      import "../scripts/send-form.js";
    </script>
  </body>
</html>